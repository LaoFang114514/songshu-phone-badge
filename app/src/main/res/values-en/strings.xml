    <!-- TutorialSettingsCard -->
    <string name="tutorial_welcome_title">Welcome to SPB</string>
    <string name="tutorial_welcome_desc">This is a quick guide to help you get started.</string>

    <string name="step1_title">1. Add a Badge</string>
    <string name="step1_desc">Tap \"Add Badge\" at the bottom of the home page, then choose an image to crop or a video as your badge content.</string>
    <string name="step2_title">2. Select a Badge</string>
    <string name="step2_desc">Tap a badge in the list to select it. The active badge shows a themed border and \"Currently in use\" label.</string>
    <string name="step3_title">3. Start Display</string>
    <string name="step3_desc">Tap the \"Start\" button in the bottom navigation bar to enter fullscreen mode and show your badge.</string>
    <string name="step4_title">4. QR Code Settings</string>
    <string name="step4_desc">In Settings → QR Code Settings, upload a QR code image. It will appear when you swipe during fullscreen.</string>
    <string name="step5_title">5. More Settings</string>
    <string name="step5_desc">In \"Basic Settings\" you can toggle reverse display, keep screen on, anti burn-in, and more.</string>

    <string name="tutorial_section_basic">Basic Operations</string>
    <string name="tutorial_section_display">Fullscreen Display</string>
    <string name="tutorial_section_settings">Settings</string>
    <string name="tutorial_section_advanced">Advanced</string>

    <string name="tut_add_image_title">Add an Image Badge</string>
    <string name="tut_add_image_desc">Tap \"Add Badge\" at the bottom of the home page, then select \"Image\" in the dialog. Crop and adjust the image area to your liking, then confirm to create the badge.</string>

    <string name="tut_add_video_title">Add a Video Badge</string>
    <string name="tut_add_video_desc">Tap \"Add Badge\" and select \"Video\", then pick a video from your gallery. The first frame is automatically saved as the cover. Videos loop continuously in fullscreen.</string>

    <string name="tut_manage_title">Manage Your Badge List</string>
    <string name="tut_manage_desc">Tap the menu button on any badge card to:\n• Rename — Change the badge name\n• Move Up / Down — Reorder badges\n• Delete — Remove a badge</string>

    <string name="tut_select_title">Select and Switch</string>
    <string name="tut_select_desc">Tap any badge card in the list to make it active. The selected badge gets a themed border and \"Currently in use\" indicator. Fullscreen display always uses the active badge.</string>

    <string name="tut_start_title">Start Fullscreen</string>
    <string name="tut_start_desc">Tap the \"Start\" button in the bottom navigation bar to enter fullscreen immersive mode. System bars hide automatically.</string>

    <string name="tut_gesture_rotate_title">Long Press to Rotate</string>
    <string name="tut_gesture_rotate_desc">In fullscreen, long press to flip the badge 180°. Useful when the phone is mounted upside down. Long press again to restore. If \"Lock Orientation\" is on, rotation is disabled.</string>

    <string name="tut_gesture_exit_title">Pinch to Exit</string>
    <string name="tut_gesture_exit_desc">In fullscreen, pinch with two fingers to exit and return to the main screen. A smooth fade transition plays on exit.</string>

    <string name="tut_gesture_qr_title">Swipe for QR Code</string>
    <string name="tut_gesture_qr_desc">In fullscreen, swipe up or down to show the QR code overlay (requires \"Swipe to Show QR Code\" enabled in settings). Tap the QR code area to dismiss.</string>

    <string name="tut_qr_swipe_title">Swipe to Switch QR Code</string>
    <string name="tut_qr_swipe_desc">When the QR code is displayed, swipe left or right to switch between multiple QR codes (requires \"Swipe to Switch QR Code\" enabled in Settings → QR Code Settings). Supports circular switching — swiping right on the last QR code wraps back to the first.</string>

    <string name="tut_battery_title">Battery Display</string>
    <string name="tut_battery_desc">In fullscreen, the battery percentage is shown at the top (requires \"Show Battery\" enabled in settings).</string>

    <string name="tut_reverse_title">Reverse Display</string>
    <string name="tut_reverse_desc">Enable \"Reverse Display\" in Settings → Basic Settings to auto-rotate the badge 180° on launch. Ideal when the phone is mounted upside down in a fursuit head.</string>

    <string name="tut_screen_on_title">Keep Screen On</string>
    <string name="tut_screen_on_desc">When enabled, the screen stays on during fullscreen playback. Perfect for long-duration badge display.</string>

    <string name="tut_anti_burnin_title">Anti Burn-in</string>
    <string name="tut_anti_burnin_desc">When enabled, the image shifts slightly every 5 minutes during fullscreen to prevent OLED screen burn-in.</string>

    <string name="tut_qr_code_title">Custom QR Code</string>
    <string name="tut_qr_code_desc">In Settings → QR Code Settings:\n• Enable \"Swipe to Show QR Code\"\n• Optionally enable \"Swipe to Switch QR Code\" to swipe left/right between QR codes during display\n• Tap the menu on the card to \"Generate from Link\" or \"Import Image\"\n• Generate from Link: Enter a URL and ZXing creates the QR code\n• Import Image: Pick a QR code image from your gallery\n• You can rename the QR code card\n• Uses the default QR image if none is set</string>

    <string name="tut_theme_title">Theme and Appearance</string>
    <string name="tut_theme_desc">In Settings → Theme Settings you can:\n• Switch between Dark / Light mode\n• Pick a theme color: Red, Orange, Yellow, Green, Teal, Blue, Purple, Pink\n• Android 12+ supports Monet, matching your wallpaper</string>

    <string name="tut_backup_title">Backup and Restore</string>
    <string name="tut_backup_desc">In Settings → Backup, two methods are supported:\n• Local Backup — Export settings and all images as a ZIP file, or restore from one\n• WebDAV Backup — Configure a server to upload or download backups\n\nGreat for switching devices or preventing data loss.</string>

    <string name="tut_language_title">Language Support</string>
    <string name="tut_language_desc">In Settings → Basic Settings → Language, you can switch between:\n• Chinese\n• English\n\nThe interface refreshes automatically after switching.</string>

