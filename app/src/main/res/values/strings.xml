    <!-- TutorialSettingsCard -->
    <string name="step1_title">1. 添加兽牌</string>
    <string name="step1_desc">在主页点击底部的「添加兽牌」按钮，选择图片裁切或视频作为兽牌内容。</string>
    <string name="step2_title">2. 选择兽牌</string>
    <string name="step2_desc">在列表中点击你想使用的兽牌，选中后底部会显示「当前使用中」。</string>
    <string name="step3_title">3. 启动展示</string>
    <string name="step3_desc">点击底部导航栏中间的「启动」按钮，即可全屏展示你选择的兽牌。</string>
    <string name="step4_title">4. 设置二维码</string>
    <string name="step4_desc">在设置 → 二维码设置中，可以上传二维码图片，展示时会显示在角落。</string>
    <string name="step5_title">5. 更多设置</string>
    <string name="step5_desc">在「基本设置」中可以调整反向显示、常亮、防烧屏等选项。</string>

    <string name="tutorial_welcome_title">欢迎使用松鼠兽牌</string>
    <string name="tutorial_welcome_desc">这是这个软件的教程</string>

